{
  "manifest_version": 3,
  "name": "Kerosene",
  "version": "0.8.0",
  "description": "Fuel for Octane - straight bullshit made by dad and claude!!!",
  "action": {
    "default_title": "Kerosene",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open the Kerosene menu"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://octane.wtf/*",
    "https://*.octane.wtf/*",
    "https://octomons.wtf/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://octane.wtf/*",
        "https://*.octane.wtf/*"
      ],
      "js": [
        "shared/compat.js",
        "shared/settings.js",
        "shared/themes.js",
        "shared/values.js",
        "shared/char-field.js",
        "content/engine.js",
        "content/values.js",
        "content/avatar-sandbox.js",
        "content/update-fx.js",
        "content/admin-widget.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://octane.wtf/theme2020/avatar*"
      ],
      "js": [
        "content/avatar-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
