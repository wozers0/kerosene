{
  "manifest_version": 3,
  "name": "Kerosene",
  "version": "0.2.0",
  "description": "Fuel for Octane - straight bullshit made by dad and claude!!!",
  "action": {
    "default_title": "Kerosene",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": ["https://octane.wtf/*", "https://*.octane.wtf/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://octane.wtf/*", "https://*.octane.wtf/*"],
      "js": ["shared/settings.js", "shared/themes.js", "shared/char-field.js", "content/engine.js"],
      "run_at": "document_start"
    }
  ]
}
